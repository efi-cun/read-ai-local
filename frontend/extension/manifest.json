{
  "manifest_version": 3,
  "name": "ReadAI Local - Meet Assistant",
  "version": "1.1.0",
  "description": "Graba automáticamente audio y video de Google Meet, toma asistencia en tiempo real y sincroniza con tu servidor local.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReadAI Local Assistant"
  }
}
